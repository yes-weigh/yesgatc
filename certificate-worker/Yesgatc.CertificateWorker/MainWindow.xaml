<Window x:Class="Yesgatc.CertificateWorker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YesGATC Certificate Worker"
        Height="720"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs"
                    Grid.Row="0"
                    Style="{StaticResource MainTabControl}">

            <!-- Queue -->
            <TabItem Header="Queue" Style="{StaticResource MainTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120" MinHeight="72"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button x:Name="RefreshButton"
                                Content="Refresh"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,3"
                                FontSize="12"
                                DockPanel.Dock="Right"
                                Click="RefreshButton_Click"/>
                        <TextBlock x:Name="QueueCountText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Idle — queues empty."/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox x:Name="ProcessFillQueueSwitch"
                                          Content="Process queue"
                                          Style="{StaticResource QueueProcessSwitch}"
                                          ToolTip="On: auto-worker runs fill &amp; certify, interleaved with signed-PDF upload (never two fills in a row if signed PDFs wait). Off: skip. Needs Auto-run."
                                          Checked="ProcessQueueSwitch_Changed"
                                          Unchecked="ProcessQueueSwitch_Changed"/>
                                <Button x:Name="FillOnlySelectedEmaapButton"
                                        Content="Fill only"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Margin="4,0,0,0"
                                        Visibility="Collapsed"
                                        ToolTip="Fill through Name of Principal Officer — does not submit or update Firebase."
                                        Click="FillOnlySelectedEmaapButton_Click"/>
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,0,0,2">
                                <TextBlock x:Name="GenerateQueueTitleText"
                                           DockPanel.Dock="Left"
                                           Text="1 · Fill &amp; certify (0)"
                                           Style="{StaticResource QueueSectionTitle}"/>
                                <TextBlock x:Name="GenerateQueueHintText"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource QueueSectionHint}"
                                           Text="Submitted · fill → certify → unsigned PDF · runs now"/>
                            </DockPanel>
                            <DataGrid x:Name="JobsGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource QueueDenseDataGrid}"
                                      SelectionChanged="JobsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RC"
                                                        Binding="{Binding RcCenterName}"
                                                        Width="0.9*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding TypeShort}"
                                                        Width="44"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Customer"
                                                        Binding="{Binding CustomerName}"
                                                        Width="1.1*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Serial"
                                                        Binding="{Binding SerialNumber}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource DataGridCellMono}"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding StatusLabel}"
                                                        Width="0.7*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Next"
                                                        Binding="{Binding NextStepLabel}"
                                                        Width="1*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="When"
                                                        Binding="{Binding PipelineDateDisplay}"
                                                        Width="0.85*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Retry"
                                                        Binding="{Binding RetryBadge}"
                                                        Width="0.55*"
                                                        ElementStyle="{StaticResource DataGridCellRetryBadge}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="GenerateEmptyText"
                                       Grid.Row="2"
                                       Margin="6,4,6,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="No submitted jobs."
                                       Visibility="Collapsed"/>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#22FFFFFF"
                                      Cursor="SizeWE"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ProcessSignerQueueSwitch"
                                      Content="Process queue"
                                      Style="{StaticResource QueueProcessSwitch}"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,2"
                                      ToolTip="On: auto-worker stamps PDF signer jobs in short bursts between eMAAP jobs. Off: list only. Needs Auto-run."
                                      Checked="ProcessQueueSwitch_Changed"
                                      Unchecked="ProcessQueueSwitch_Changed"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,2">
                                <TextBlock x:Name="SignerQueueTitleText"
                                           DockPanel.Dock="Left"
                                           Text="2 · PDF signer (0)"
                                           Style="{StaticResource QueueSectionTitle}"/>
                                <TextBlock x:Name="SignerQueueHintText"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource QueueSectionHint}"
                                           Text="pdf_signer RCs · certified · seq &gt;2304 · unsigned"/>
                            </DockPanel>
                            <DataGrid x:Name="SignerJobsGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource QueueDenseDataGrid}"
                                      SelectionChanged="SignerJobsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RC"
                                                        Binding="{Binding RcCenterName}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding TypeShort}"
                                                        Width="44"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Customer"
                                                        Binding="{Binding CustomerName}"
                                                        Width="1*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Serial"
                                                        Binding="{Binding SerialNumber}"
                                                        Width="0.7*"
                                                        ElementStyle="{StaticResource DataGridCellMono}"/>
                                    <DataGridTextColumn Header="Certificate"
                                                        Binding="{Binding CertificateNumber}"
                                                        Width="1.4*"
                                                        ElementStyle="{StaticResource DataGridCellMono}"/>
                                    <DataGridTextColumn Header="Next"
                                                        Binding="{Binding NextStepLabel}"
                                                        Width="1*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="When"
                                                        Binding="{Binding PipelineDateDisplay}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="SignerEmptyText"
                                       Grid.Row="2"
                                       Margin="6,4,6,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="No PDF signer jobs."
                                       Visibility="Collapsed"/>
                        </Grid>

                        <GridSplitter Grid.Column="3"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#22FFFFFF"
                                      Cursor="SizeWE"/>

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ProcessSignedQueueSwitch"
                                      Content="Process queue"
                                      Style="{StaticResource QueueProcessSwitch}"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,2"
                                      ToolTip="On: auto-worker uploads signed PDFs (stamp, DSC, or manual). Interleaved with fill — does not wait for fill to empty. Needs Auto-run."
                                      Checked="ProcessQueueSwitch_Changed"
                                      Unchecked="ProcessQueueSwitch_Changed"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,2">
                                <TextBlock x:Name="SignedQueueTitleText"
                                           DockPanel.Dock="Left"
                                           Text="3 · Signed PDF → eMAAP (0)"
                                           Style="{StaticResource QueueSectionTitle}"/>
                                <TextBlock x:Name="SignedQueueHintText"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource QueueSectionHint}"
                                           Text="Seq &gt;2304 · Firebase signed · uploads after generate empty"/>
                            </DockPanel>
                            <DataGrid x:Name="SignedJobsGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource QueueDenseDataGrid}"
                                      SelectionChanged="SignedJobsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RC"
                                                        Binding="{Binding RcCenterName}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding TypeShort}"
                                                        Width="44"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Customer"
                                                        Binding="{Binding CustomerName}"
                                                        Width="1*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Serial"
                                                        Binding="{Binding SerialNumber}"
                                                        Width="0.7*"
                                                        ElementStyle="{StaticResource DataGridCellMono}"/>
                                    <DataGridTextColumn Header="Certificate"
                                                        Binding="{Binding CertificateNumber}"
                                                        Width="1.4*"
                                                        ElementStyle="{StaticResource DataGridCellMono}"/>
                                    <DataGridTextColumn Header="Next"
                                                        Binding="{Binding NextStepLabel}"
                                                        Width="1*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="When"
                                                        Binding="{Binding PipelineDateDisplay}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource DataGridCellMuted}"/>
                                    <DataGridTextColumn Header="Retry"
                                                        Binding="{Binding RetryBadge}"
                                                        Width="0.5*"
                                                        ElementStyle="{StaticResource DataGridCellRetryBadge}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="SignedEmptyText"
                                       Grid.Row="2"
                                       Margin="6,4,6,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="No signed PDFs waiting."
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,4,0,2" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="PdfSignerSignButton"
                                    Content="Sign"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="8,3"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    ToolTip="Stamp the RC officer signature at the DSC officer-sign position and upload the signed PDF to Firebase. Also saves a copy to Downloads."
                                    Click="PdfSignerSignButton_Click"/>
                            <Button x:Name="PdfSignerDownloadButton"
                                    Content="Download"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,3"
                                    FontSize="12"
                                    Margin="4,0,0,0"
                                    Visibility="Collapsed"
                                    ToolTip="Download the unsigned eMAAP PDF to Downloads."
                                    Click="PdfSignerDownloadButton_Click"/>
                        </StackPanel>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Document"/>
                    </DockPanel>

                    <TextBox x:Name="JobDetailBox"
                             Grid.Row="3"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="1"
                             BorderBrush="#22FFFFFF"
                             Background="#14000000"
                             Padding="6,4"
                             Foreground="{StaticResource TextMainBrush}"
                             FontFamily="Consolas"
                             FontSize="11"
                             Text="Select a job to view its Firestore document."/>
                </Grid>
            </TabItem>

            <!-- Worker / Account -->
            <TabItem Header="Worker" Style="{StaticResource MainTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="WorkerBrandText"
                                   Text="Certificate Worker"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleGradientBrush}"
                                   Margin="0,0,0,14"/>

                        <Border Style="{StaticResource GlassPanel}"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Expander x:Name="SignInExpander"
                                      Style="{StaticResource GlassExpander}"
                                      IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SignInStatusDot"
                                                 Style="{StaticResource StatusDot}"
                                                 Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Account"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="SignInSummaryText"
                                                       Text="Not signed in"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMainBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel x:Name="PortalLoginPanel">
                                    <TextBlock x:Name="AccountHintText"
                                               Text="Aadhar + password"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AadharBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource GlassTextBox}"/>
                                        <TextBox x:Name="PasswordBox"
                                                 Grid.Column="2"
                                                 Style="{StaticResource GlassTextBox}"/>
                                    </Grid>

                                    <Button x:Name="SignInButton"
                                            Content="Sign in"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,14"
                                            Click="SignInButton_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="ChromeProfilePanel">
                                    <TextBlock x:Name="ChromeProfileLabel"
                                               Text="Chrome profile (DeepSeek / cookies)"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ChromeProfileCombo"
                                              Margin="0,0,0,6"
                                              MinHeight="32"
                                              DisplayMemberPath="Label"
                                              ToolTip="Chrome profile used for eMAAP + DeepSeek. Saved for next launches."/>
                                    <TextBlock x:Name="ChromeProfileHint"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Text="Pick a Chrome profile before launching the browser."/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SaveChromeProfileButton"
                                                Grid.Column="0"
                                                Content="Save profile"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SaveChromeProfileButton_Click"/>
                                        <Button x:Name="ResetChromeProfileButton"
                                                Grid.Column="2"
                                                Content="Reset &amp; restart"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="Clear saved Chrome profile preference and restart the worker."
                                                Click="ResetChromeProfileButton_Click"/>
                                    </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="DocaLoginPanel">
                                        <TextBlock Text="eMAAP / DOCA login" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DocaEmailBox"
                                                 Style="{StaticResource GlassTextBox}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox x:Name="DocaPasswordBox"
                                                 Style="{StaticResource GlassTextBox}"
                                                 Margin="0,0,0,14"/>
                                    </StackPanel>

                                    <StackPanel x:Name="VpsAccountExtrasPanel">
                                    <TextBlock Text="eMAAP email OTP"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EmaapOtpBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource GlassTextBox}"
                                                 MaxLength="8"
                                                 ToolTip="Paste the 6-digit OTP from admin@yesweigh.in"/>
                                        <Button x:Name="SubmitEmaapOtpButton"
                                                Grid.Column="2"
                                                Content="Submit OTP"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6"
                                                Click="SubmitEmaapOtpButton_Click"/>
                                    </Grid>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="CaptchaApiKeyHint"
                                                   DockPanel.Dock="Right"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Text=""/>
                                        <TextBlock Text="Captcha AI Key (Gemini/OpenAI)"
                                                   Style="{StaticResource FieldLabel}"/>
                                    </DockPanel>
                                    <TextBox x:Name="CaptchaApiKeyBox"
                                             Style="{StaticResource GlassTextBox}"
                                             Margin="0,0,0,12"/>

                                    <Button x:Name="SaveCredsButton"
                                            Content="Save Credentials"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="SaveCredsButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Auto worker"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <CheckBox x:Name="AutoRunCheckBox"
                                          Content="Auto-run (unattended, queue order)"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextMainBrush}"
                                          Checked="AutoRunCheckBox_Changed"
                                          Unchecked="AutoRunCheckBox_Changed"/>
                                <TextBlock Text="Off = idle. On = one eMAAP job (fill or signed-upload, interleaved), then a PDF-signer stamp burst of up to 8. Login pause still stamps."
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,4"/>
                                <CheckBox x:Name="StartWithWindowsCheckBox"
                                          Content="Start with Windows (after reboot / sign-in)"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextMainBrush}"
                                          Checked="StartWithWindowsCheckBox_Changed"
                                          Unchecked="StartWithWindowsCheckBox_Changed"/>
                                <TextBlock x:Name="StartWithWindowsHint"
                                           Text="Registers logon + startup task. After host reboot: RDP in once, or use Windows auto-logon."
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,8"/>
                                <TextBlock x:Name="AutoWorkerStatusText"
                                           Text="Waiting to sign in…"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMainBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0"/>
                                <Button x:Name="ProcessSelectedEmaapButton"
                                        Content="Process selected"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,12,0,0"
                                        Padding="14,6"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"
                                        Click="ProcessSelectedEmaapButton_Click"/>
                                <TextBlock Text="Session probe (minutes)"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"/>
                                <TextBox x:Name="DocaSessionProbeMinutesBox"
                                         Style="{StaticResource GlassTextBox}"
                                         LostFocus="DocaSessionProbeMinutesBox_LostFocus"/>
                                <TextBlock Text="While logged in, open IC verification on this interval to detect eMAAP logout and measure session length. 0 = disabled."
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Activity -->
            <TabItem Header="Activity" Style="{StaticResource MainTabItem}">
                <Border Style="{StaticResource GlassPanel}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Activity · latest on top"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="ActivityLogList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 FontSize="12"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 MouseDoubleClick="ActivityLogList_MouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Selected" Click="CopyLogItem_Click"/>
                                    <MenuItem Header="Copy All Logs" Click="CopyAllLogs_Click"/>
                                    <MenuItem Header="Open Log File" Click="OpenLogFile_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip" Value="{Binding Text}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,2">
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <Border x:Name="CaptchaPreviewBorder"
                                                Visibility="Collapsed"
                                                Margin="0,6,0,2"
                                                Padding="8"
                                                CornerRadius="8"
                                                Background="#221E293B"
                                                BorderBrush="#33475569"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CaptchaResolvedText, StringFormat=Resolved: {0}}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#A7F3D0"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="Original"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,0,0,4"/>
                                                <Image Source="{Binding CaptchaImage}"
                                                       MaxHeight="96"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <TextBlock Text="Sent to AI"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,10,0,4"/>
                                                <Image Source="{Binding CaptchaAiImage}"
                                                       MaxHeight="96"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasCaptchaPreview}" Value="True">
                                            <Setter TargetName="CaptchaPreviewBorder" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Always-visible status strip -->
        <Border Grid.Row="1"
                Padding="8,4"
                Margin="0,4,0,0"
                Background="#14000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <Ellipse x:Name="StatusStateDot"
                             Style="{StaticResource StatusDot}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusStateText"
                               Text="Idle"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTimestampText"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Sign in to start."
                           TextWrapping="Wrap"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMainBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
