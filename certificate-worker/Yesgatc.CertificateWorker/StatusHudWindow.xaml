<Window x:Class="Yesgatc.CertificateWorker.StatusHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worker status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        MinWidth="280">
    <Border x:Name="RootBorder"
            Style="{StaticResource GlassPanel}"
            Padding="14,12"
            Margin="8"
            Cursor="SizeAll"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button x:Name="CollapseButton"
                        DockPanel.Dock="Right"
                        Content="−"
                        Width="28"
                        Height="24"
                        Margin="8,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        ToolTip="Collapse / expand"
                        Click="CollapseButton_Click"
                        Background="#22000000"
                        Foreground="{StaticResource TextMutedBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        Padding="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot"
                             Style="{StaticResource StatusDot}"
                             Width="10"
                             Height="10"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StateText"
                               Text="Idle"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock x:Name="TimestampText"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Text="Starting…"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource TextMainBrush}"/>

            <TextBlock x:Name="ContextText"
                       Grid.Row="2"
                       Text=""
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource TextMutedBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
