<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yesgatc.EmaapEngine.MainWindow"
        Title="EmaapEngine"
        Width="920"
        Height="680"
        MinWidth="720"
        MinHeight="520">
    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto,180">
        <TextBlock Grid.Row="0"
                   Text="EmaapEngine"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#DDDDDD"
                Background="#F7F7F8"
                Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock Text="RC Admin Aadhar + portal password"/>
                <Grid ColumnDefinitions="*,8,*">
                    <TextBox x:Name="AadharBox" Watermark="Aadhar"/>
                    <TextBox x:Name="PasswordBox" Grid.Column="2" PasswordChar="•" Watermark="Password"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SignInButton" Content="Sign in" Click="SignInButton_Click"/>
                    <CheckBox x:Name="AutoRunCheckBox" Content="Auto-run" IsChecked="True"/>
                    <Button Content="Save" Click="SaveButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Sign in with this RC Admin account. Type captcha and OTP in the browser." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="JobsList" Grid.Row="2" Margin="0,0,0,8"/>

        <TextBlock x:Name="QueueHintText"
                   Grid.Row="3"
                   Margin="0,0,0,8"
                   Text="Queue empty."/>

        <TextBox x:Name="LogBox"
                 Grid.Row="4"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Menlo, Consolas, monospace"
                 FontSize="12"/>
    </Grid>
</Window>
